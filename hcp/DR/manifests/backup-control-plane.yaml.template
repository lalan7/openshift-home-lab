---
# Manual Backup for HCP Control Plane
#
# Required environment variables:
#   BACKUP_NAME                   - Unique backup name (e.g., hcp-backup-20250109)
#   HOSTED_CLUSTER_NAMESPACE      - Namespace where HostedCluster CR lives (e.g., clusters)
#   HOSTED_CONTROL_PLANE_NAMESPACE - Namespace of control plane pods (e.g., clusters-my-hcp)
#
# Usage:
#   export BACKUP_NAME="hcp-backup-$(date +%Y%m%d-%H%M%S)"
#   export HOSTED_CLUSTER_NAMESPACE="clusters"
#   export HOSTED_CONTROL_PLANE_NAMESPACE="clusters-my-hcp"
#   envsubst < backup-control-plane.yaml.template | oc apply -f -
#
apiVersion: velero.io/v1
kind: Backup
metadata:
  name: ${BACKUP_NAME}
  namespace: openshift-adp
  labels:
    velero.io/storage-location: hcp-dpa-1
    app.kubernetes.io/component: hcp-backup
    hcp.openshift.io/backup-type: control-plane
spec:
  hooks: {}
  includedNamespaces:
    - ${HOSTED_CLUSTER_NAMESPACE}
    - ${HOSTED_CONTROL_PLANE_NAMESPACE}
  includedResources:
    # HCP Core Resources
    - hostedclusters
    - hostedcontrolplanes
    - nodepools
    # Secrets and Configuration
    - secrets
    - configmaps
    # RBAC
    - serviceaccounts
    - roles
    - rolebindings
    # Cluster API Resources
    - agentmachines
    - machines.cluster.x-k8s.io
    - agentclusters
    - agentmachinetemplates
    # Storage for etcd
    - persistentvolumeclaims
  excludedResources:
    - events
    - pods
  storageLocation: hcp-dpa-1
  # Enable CSI snapshots for etcd PVCs
  snapshotMoveData: true
  datamover: velero
  defaultVolumesToFsBackup: false
  # Backup timeout
  ttl: 720h0m0s
