---
# Restore from HCP Backup
#
# Required environment variables:
#   RESTORE_NAME - Unique restore name
#   BACKUP_NAME  - Name of the backup to restore from
#
# Usage:
#   export RESTORE_NAME="hcp-restore-$(date +%Y%m%d-%H%M%S)"
#   export BACKUP_NAME="hcp-backup-20250109-120000"
#   envsubst < restore.yaml.template | oc apply -f -
#
apiVersion: velero.io/v1
kind: Restore
metadata:
  name: ${RESTORE_NAME}
  namespace: openshift-adp
  labels:
    app.kubernetes.io/component: hcp-restore
spec:
  backupName: ${BACKUP_NAME}
  # Restore all namespaces from the backup
  includedNamespaces:
    - "*"
  # Restore all resources from the backup
  includedResources:
    - "*"
  # Preserve existing node ports to maintain connectivity
  preserveNodePorts: true
  # Existing resource policy: update or skip
  existingResourcePolicy: update
  hooks: {}
  # Restore PV data
  restorePVs: true
