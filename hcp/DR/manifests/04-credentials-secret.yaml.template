---
# S3 Credentials Secret for OADP
# 
# Usage:
#   1. Copy this file: cp 04-credentials-secret.yaml.template 04-credentials-secret.yaml
#   2. Replace placeholders with actual values
#   3. Apply: oc apply -f 04-credentials-secret.yaml
#
# WARNING: Do NOT commit the filled-in secret to version control!
#
apiVersion: v1
kind: Secret
metadata:
  name: cloud-credentials
  namespace: openshift-adp
type: Opaque
stringData:
  cloud: |
    [default]
    aws_access_key_id=${S3_ACCESS_KEY}
    aws_secret_access_key=${S3_SECRET_KEY}
