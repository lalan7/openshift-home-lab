---
# DataProtectionApplication for HCP Backup using ODF RGW
#
# Prerequisites:
#   1. OADP operator installed
#   2. ObjectBucketClaim created: oc apply -f oadp-rgw-bucket.yaml
#   3. Credentials secret created: ./scripts/setup-rgw-credentials.sh
#
# Usage:
#   oc apply -f 05-dpa-rgw.yaml.template
#
# Note: This uses the internal RGW endpoint with self-signed certificate.
#
apiVersion: oadp.openshift.io/v1alpha1
kind: DataProtectionApplication
metadata:
  name: hcp-dpa
  namespace: openshift-adp
  labels:
    app.kubernetes.io/component: oadp-backup
    app.kubernetes.io/part-of: hcp-dr
spec:
  backupLocations:
    - velero:
        config:
          profile: default
          region: us-east-1
          s3ForcePathStyle: "true"
          s3Url: https://rook-ceph-rgw-ocs-storagecluster-cephobjectstore.openshift-storage.svc:443
          insecureSkipTLSVerify: "true"
        credential:
          key: cloud
          name: cloud-credentials
        default: true
        objectStorage:
          bucket: ${BUCKET_NAME}
          prefix: hcp-backups
        provider: aws
  configuration:
    nodeAgent:
      enable: true
      uploaderType: kopia
    velero:
      defaultPlugins:
        - openshift
        - aws
        - csi
      resourceTimeout: 10m
  snapshotLocations:
    - velero:
        config:
          profile: default
          region: us-east-1
        provider: aws
